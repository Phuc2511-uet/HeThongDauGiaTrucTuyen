<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-background-color:#0F172A;-fx-padding:25;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.AdminListUserController">
    <Label style="-fx-text-fill:white;-fx-font-size:25;-fx-font-weight:bold;" text="Danh sách người dùng">
      <VBox.margin>
         <Insets left="-10.0" top="-25.0" />
      </VBox.margin></Label>
    <ScrollPane fitToWidth="true" style="-fx-background:#0F172A;-fx-background-color:transparent;" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="userContainer" spacing="15" style="-fx-padding:10;" />
        </content>
    </ScrollPane>
    <HBox alignment="CENTER_RIGHT">

        <Button onAction="#handleAdminCreateAccount" style="-fx-background-color:#2563EB;                        -fx-text-fill:white;                        -fx-font-size:14;                        -fx-font-weight:bold;                        -fx-background-radius:10;                        -fx-padding:10 20 10 20;" text="Cấp tài khoản" />
    </HBox>
</VBox>
