<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.controller.AdminListUserController" spacing="20" style="-fx-background-color:#0F172A;-fx-padding:25;">
    <Label text="Danh sách người dùng" style="-fx-text-fill:white;-fx-font-size:25;-fx-font-weight:bold;"/>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background:#0F172A;-fx-background-color:transparent;">
        <content>
            <VBox fx:id="userContainer" spacing="15" style="-fx-padding:10;"/>
        </content>
    </ScrollPane>
    <HBox alignment="CENTER_RIGHT">

        <Button text="Cấp tài khoản"
                onAction="#handleAdminCreateAccount"
                style="-fx-background-color:#2563EB;
                       -fx-text-fill:white;
                       -fx-font-size:14;
                       -fx-font-weight:bold;
                       -fx-background-radius:10;
                       -fx-padding:10 20 10 20;"/>
    </HBox>
</VBox>