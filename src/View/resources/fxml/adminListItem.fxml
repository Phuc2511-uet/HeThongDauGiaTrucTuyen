<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>

<VBox xmlns="http://javafx.com/fxml" xmlns:fx="http://javafx.com/fxml" fx:controller="Controllers.controller.AdminListItemController" spacing="20">
    <Label text="Quản lý vật phẩm hệ thống" style="-fx-text-fill:white;-fx-font-size:25;-fx-font-weight:bold;"/>
    <VBox VBox.vgrow="ALWAYS" spacing="20">
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background:#0F172A;-fx-background-color:transparent;">
            <content>
                <VBox fx:id="itemContainer" spacing="15" style="-fx-padding:10;"/>
            </content>
        </ScrollPane>
    </VBox>
</VBox>