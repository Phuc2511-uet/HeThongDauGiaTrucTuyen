<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #0F172A;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.controller.BidHistoryPopupController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="LỊCH SỬ ĐẶT GIÁ THEO THỜI GIAN THỰC" textFill="#38BDF8">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <TableView fx:id="tableHistory" prefHeight="380.0" prefWidth="500.0"
                   style="-fx-background-color: #1E293B; -fx-text-background-color: white; -fx-base: #1E293B; -fx-background-radius: 10;">
            <columns>
                <TableColumn fx:id="colTime" prefWidth="140.0" text="Thời gian" />
                <TableColumn fx:id="colBidder" prefWidth="180.0" text="Người đặt giá" />
                <TableColumn fx:id="colPrice" prefWidth="140.0" text="Mức giá ($)" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>