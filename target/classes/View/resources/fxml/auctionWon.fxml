<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" style="-fx-background-color: #0F172A;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.controller.AuctionWonController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label text="Các phiên đấu giá đã thắng" textFill="WHITE">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <ScrollPane fitToWidth="true" style="-fx-background: #0F172A; -fx-border-color: #0F172A; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="auctionContainer" spacing="15.0" style="-fx-background-color: #0F172A; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;" />
            </content>
        </ScrollPane>
    </children>
</VBox>